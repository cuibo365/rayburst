{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-cloud-drive",
  "description": "Allow the embedded Baidu Netdisk webview to invoke cloud-drive commands",
  "remote": {
    "urls": ["https://*.baidu.com", "https://baidu.com"]
  },
  "local": false,
  "permissions": [
    "allow-cloud-drive-baidu-download",
    "allow-cloud-drive-baidu-close"
  ]
}
